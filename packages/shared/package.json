{
  "name": "masarx-shared",
  "version": "0.5.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./messages/*": "./src/messages/*",
    "./supabase": "./src/supabase/index.ts",
    "./supabase/*": "./src/supabase/*",
    "./types": "./src/types/index.ts",
    "./types/*": "./src/types/*",
    "./schedules": "./src/schedules/index.ts",
    "./ai": "./src/ai/index.ts",
    "./ai/*": "./src/ai/*",
    "./i18n": "./src/i18n/index.ts",
    "./format": "./src/format/index.ts",
    "./lectures": "./src/lectures/index.ts",
    "./quiz": "./src/quiz/index.ts"
  },
  "description": "Masar X shared package — translations, types, Supabase client factory, AI client. Consumed by apps/{web,desktop,mobile} via the workspace protocol (research.md §1, §4, §5, §9; contracts/ directory).",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "typescript": "^5.5.3",
    "vitest": "5.1.1"
  }
}
